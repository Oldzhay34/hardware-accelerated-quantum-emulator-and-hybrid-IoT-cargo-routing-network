# Python
.venv/
__pycache__/
*.pyc

# IDE / editor
.idea/
.ipynb_checkpoints/

# Claude Code local state (bkz. Faz 0 setup notu — kimlik bilgisi içerebilir)
.claude/

# Sırlar — gerçek .env asla commit edilmez, yalnızca .env.example
.env
.env.*
!.env.example
!**/.env.example
!*.env.enc
*.pem
*.p12
*.jks

# age özel anahtarları — bunlar repoda DEĞİL, %APPDATA%\sops\age\keys.txt'te.
# Yine de kazara kopyalanma ihtimaline karşı desen olarak kapatılıyor.
# NOT: secrets.enc.yaml şifrelidir ve commit EDİLİR — buradaki desenler onu kapsamaz.
keys.txt
*.agekey
age-key*.txt

# Büyük ikili dosyalar — bkz. docs/repo-conventions.md §3 (harici depo kararı)
artifacts/bitstream/*
artifacts/overlay/*
artifacts/models/*
